flowchart TB
  subgraph clients [Clients]
    Browser[Web Browser]
    ApiClient[REST / API Client]
  end

  subgraph ofbiz [OFBiz JVM]
    Catalina[Catalina / Tomcat]
    Webapp[Webapp Controllers + Widgets]
    Rest[rest-api]
    Services[Service Engine]
    Jobs[Job Poller / JobSandbox]
    JMS[JMS Service Engine optional]
    Entity[Entity Engine]
    Security[Security / UserLogin]
  end

  subgraph data [Data stores]
    H2[(H2 default)]
    PG[(PostgreSQL optional)]
  end

  Browser --> Catalina
  ApiClient --> Catalina
  Catalina --> Webapp
  Catalina --> Rest
  Webapp --> Services
  Rest --> Services
  Services --> Entity
  Services --> Security
  Jobs --> Services
  JMS -.-> Services
  Entity --> H2
  Entity -.-> PG
